{
  "name": "nutriai-nutrition-agent",
  "description": "NutriAI – The Smartest AI Nutrition Assistant powered by IBM Granite (watsonx.ai). Problem Statement #8.",
  "repository": "https://github.com/YOUR_USERNAME/nutrition-agent",
  "logo": "https://i.imgur.com/placeholder.png",
  "keywords": ["nutrition", "ibm-granite", "watsonx", "ai", "flask", "python", "meal-planning"],
  "website": "http://localhost:5000",
  "success_url": "/",
  "scripts": {
    "postdeploy": "echo NutriAI deployed successfully"
  },
  "env": {
    "IBM_API_KEY": {
      "description": "IBM Cloud API Key from cloud.ibm.com/iam/apikeys",
      "required": true
    },
    "IBM_WATSONX_URL": {
      "description": "IBM watsonx.ai service URL",
      "value": "https://us-south.ml.cloud.ibm.com",
      "required": true
    },
    "IBM_PROJECT_ID": {
      "description": "IBM watsonx.ai Project ID from dataplatform.cloud.ibm.com",
      "required": true
    },
    "IBM_GRANITE_MODEL_ID": {
      "description": "IBM Granite model ID",
      "value": "ibm/granite-3-1-8b-base",
      "required": true
    },
    "FLASK_SECRET_KEY": {
      "description": "Secret key for Flask session management",
      "generator": "secret",
      "required": true
    },
    "FLASK_ENV": {
      "description": "Flask environment",
      "value": "production",
      "required": false
    },
    "PORT": {
      "description": "Port to run the server on",
      "value": "5000",
      "required": false
    },
    "NUTRITIONIX_APP_ID": {
      "description": "Nutritionix App ID (optional) from nutritionix.com",
      "required": false
    },
    "NUTRITIONIX_API_KEY": {
      "description": "Nutritionix API Key (optional)",
      "required": false
    },
    "USDA_API_KEY": {
      "description": "USDA FoodData Central API Key (optional) from fdc.nal.usda.gov",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "free"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "stack": "heroku-22"
}
