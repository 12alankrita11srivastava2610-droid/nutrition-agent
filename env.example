# ============================================================
#  IBM Cloud / watsonx.ai Configuration
# ============================================================

# IBM watsonx.ai API key – obtain from IBM Cloud IAM console
IBM_API_KEY=your_ibm_api_key_here

# IBM watsonx.ai service URL (region-specific)
# Example: https://us-south.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloud project ID – found in your watsonx.ai project settings
IBM_PROJECT_ID=your_project_id_here

# IBM Granite model ID to use (default: granite-13b-instruct-v2)
# Options: ibm/granite-13b-instruct-v2 | ibm/granite-3-8b-instruct
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ============================================================
#  Flask Application Settings
# ============================================================

# Secret key for Flask session management (change in production)
FLASK_SECRET_KEY=nutrition-agent-secret-key-change-me

# Flask environment: development | production
FLASK_ENV=development

# Port to run the server on
PORT=5000

# ============================================================
#  Optional – Nutritionix API (for food database lookup)
#  Sign up free at: https://www.nutritionix.com/business/api
# ============================================================
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here
NUTRITIONIX_API_KEY=your_nutritionix_api_key_here

# ============================================================
#  Optional – USDA FoodData Central API
#  Free key at: https://fdc.nal.usda.gov/api-key-signup.html
# ============================================================
USDA_API_KEY=your_usda_api_key_here
